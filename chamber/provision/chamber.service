[Unit]
Description=PR Detonator Chamber API
After=network-online.target docker.service tetragon.service detonator-egress.service
Requires=docker.service detonator-egress.service
Wants=network-online.target tetragon.service

[Service]
# Root: needs docker and the root-only Tetragon export log. Untrusted code never runs here,
# only inside the hardened container.
User=root
WorkingDirectory=/opt/pr-detonator
EnvironmentFile=/etc/pr-detonator/env
# TLS with a self-signed cert (setup.sh) that the Brain pins: private-repo clone tokens only
# ever travel encrypted.
ExecStart=/opt/pr-detonator/venv/bin/uvicorn chamber.server:app --host 0.0.0.0 --port 8443 --no-access-log --ssl-keyfile /etc/pr-detonator/tls/key.pem --ssl-certfile /etc/pr-detonator/tls/cert.pem
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
