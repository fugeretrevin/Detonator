# Secrets
.env
.env.*
!.env.example
*.pem
*.key
# The SBOM signing *public* key is meant to be published: without it nobody can verify the
# committed behavior records. Private keys stay covered by the rule above.
!eval/sbom/public_key.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Remotion / motion-graphics workspace (owner's demo asset source). node_modules alone is
# ~16k files; git archive only ships tracked files, but an accidental git add -A would
# balloon the repo and the release artifact.
detonator-motion-source/node_modules/
detonator-motion-source/out/
# Release artifact built by scripts/scan_release.py --keep; never committed.
/detonator-submission.zip
