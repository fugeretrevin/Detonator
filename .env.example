# Local development only. In production these live in Modal secrets (Brain)
# and /etc/pr-detonator/env (Chamber). Never commit real values.

# --- Modal secret: github-app ---
GITHUB_APP_ID=
# Either the PEM contents (newlines may be escaped as \n) or a path to the .pem file
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# --- Modal secret: llama ---
# Meta Model API key from dev.meta.ai (OpenAI-compatible; not the older api.llama.com)
LLAMA_API_KEY=
LLAMA_MODEL=muse-spark-1.3
LLAMA_BASE_URL=https://api.meta.ai/v1

# --- Modal secret: chamber ---
CHAMBER_URL=http://<vm-ip>:8443
CHAMBER_SECRET=

# --- Modal secret: detonator-config ---
# Comma-separated GitHub account logins (users or orgs) whose installations we process
ALLOWED_ACCOUNTS=
# "mock" returns a recorded fixture instead of calling the Chamber; "http" calls CHAMBER_URL
CHAMBER_MODE=mock
MOCK_CHAMBER_FIXTURE=detonate_result_e4.json

# --- Local scripts only ---
GITHUB_INSTALLATION_ID=
DEMO_REPO=owner/repo
